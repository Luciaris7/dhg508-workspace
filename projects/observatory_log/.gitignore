# Large generated or local-only artifacts
artifacts/**
!artifacts/
!artifacts/README.md

# Local databases
*.sqlite
*.sqlite3
*.db
*.duckdb

# Python/Notebook noise
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS/editor noise
.DS_Store
.vscode/
.idea/

# Downloaded source PDFs: recorded in sources/raw/MANIFEST.md instead of committed
sources/raw/*.pdf

# LaTeX build residue. The deliverable is paper/design-paper.pdf; everything else
# below it is regenerated by XeLaTeX + Biber, so it stays out of the repository.
paper/*.aux
paper/*.bcf
paper/*.blg
paper/*.bbl
paper/*.log
paper/*.out
paper/*.run.xml
paper/*.toc
paper/main.pdf
