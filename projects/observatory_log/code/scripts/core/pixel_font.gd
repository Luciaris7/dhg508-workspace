class_name PixelFont
extends RefCounted
## Bitmap font generated by tools/gen_font.py (atlas PNG + JSON metrics).
## Draws glyph by glyph with draw_texture_rect_region, so it can scale by
## integers, tint, and jitter individual glyphs (the Day 4 interference).

var tex: Texture2D
var glyphs := {}
var cell_h := 8
var base := 7
var pad := 0
var gscale := 1
var space := 3
var line := 10


static func load_font(name: String) -> PixelFont:
	var f := PixelFont.new()
	f.tex = load("res://assets/fonts/%s.png" % name)
	var txt := FileAccess.get_file_as_string("res://assets/fonts/%s.json" % name)
	var d: Dictionary = JSON.parse_string(txt)
	f.cell_h = int(d["cell_h"])
	f.base = int(d["base"])
	f.pad = int(d["pad"])
	f.gscale = int(d["scale"])
	f.space = int(d["space"])
	f.line = int(d.get("line", f.cell_h + 2 * f.gscale))
	var g: Dictionary = d["glyphs"]
	for k in g.keys():
		var a: Array = g[k]
		f.glyphs[k] = [Rect2(a[0], a[1], a[2], a[3]), int(a[4])]
	return f


func _glyph(ch: String) -> Array:
	if glyphs.has(ch):
		return glyphs[ch]
	return glyphs.get("?", glyphs[" "])


func width(text: String, s: int = 1) -> int:
	var w := 0
	for i in text.length():
		w += int(_glyph(text[i])[1]) * s
	return maxi(0, w - gscale * s)


func height(s: int = 1) -> int:
	return cell_h * s


## Distance between baselines of consecutive lines.
func line_h(s: int = 1) -> int:
	return line * s


## Top offset that vertically centres one line of text in a box of height h.
func vcenter(h: float, s: int = 1) -> float:
	return roundf((h - cell_h * s) * 0.5)


## Draw text with its top-left at pos. Returns the advance width.
func draw(ci: CanvasItem, pos: Vector2, text: String, color: Color = Color.WHITE, s: int = 1, jitter: float = 0.0, seed: int = 0) -> int:
	var x := pos.x
	for i in text.length():
		var g: Array = _glyph(text[i])
		var r: Rect2 = g[0]
		var off := Vector2.ZERO
		if jitter > 0.0:
			var h := _hash(i, seed)
			if h < 0.35:
				off = Vector2(roundf((_hash(i, seed + 7) - 0.5) * 2.0 * jitter), roundf((_hash(i, seed + 3) - 0.5) * jitter))
		var dst := Rect2(Vector2(roundf(x) - pad * s, roundf(pos.y) - pad * s) + off * s, r.size * s)
		if text[i] != " ":
			ci.draw_texture_rect_region(tex, dst, r, color)
		x += int(g[1]) * s
	return int(x - pos.x)


func draw_centered(ci: CanvasItem, center: Vector2, text: String, color: Color = Color.WHITE, s: int = 1, jitter: float = 0.0, seed: int = 0) -> void:
	var w := width(text, s)
	draw(ci, Vector2(roundf(center.x - w * 0.5), roundf(center.y - cell_h * s * 0.5)), text, color, s, jitter, seed)


## Draw with a 1px dark shadow (readability over busy pixels).
func draw_shadowed(ci: CanvasItem, pos: Vector2, text: String, color: Color, s: int = 1, shadow: Color = Color(0, 0, 0, 0.85)) -> void:
	draw(ci, pos + Vector2(s, s), text, shadow, s)
	draw(ci, pos, text, color, s)


## Greedy word wrap. Honors "\n". Words longer than a line are split.
func wrap(text: String, max_w: int, s: int = 1) -> PackedStringArray:
	var out := PackedStringArray()
	for para in text.split("\n"):
		if para == "":
			out.append("")
			continue
		var indent := ""
		while indent.length() < para.length() and para[indent.length()] == " ":
			indent += " "
		var words := _tokens(para.strip_edges(true, false))
		var line := ""
		for w in words:
			var spaced := w.begins_with(SP)
			if spaced:
				w = w.substr(1)
			var joint := " " if spaced or not (_is_cjk(w) or _is_cjk(line.right(1))) else ""
			var cand: String = (indent + w) if line == "" else (line + joint + w)
			if width(cand, s) <= max_w:
				line = cand
			else:
				if line != "":
					out.append(line)
				line = indent + w
				while width(line, s) > max_w and line.length() > 1:
					var cut := line.length() - 1
					while cut > 1 and width(line.substr(0, cut), s) > max_w:
						cut -= 1
					out.append(line.substr(0, cut))
					line = line.substr(cut)
		out.append(line)
	return out


## Words for wrapping: space-separated runs, but every CJK character (with
## any closing punctuation after it) is its own word, so Chinese breaks
## anywhere and never starts a line with a comma.
static func _tokens(s: String) -> PackedStringArray:
	var out := PackedStringArray()
	var cur := ""
	var gap := false
	var i := 0
	while i < s.length():
		var ch := s[i]
		if ch == " ":
			if cur != "":
				out.append(cur)
			cur = ""
			gap = true
		elif _is_cjk(ch):
			if cur != "":
				out.append(cur)
			cur = (SP if gap else "") + ch
			gap = false
			while i + 1 < s.length() and "，。、：；！？）》”’…".contains(s[i + 1]):
				i += 1
				cur += s[i]
			out.append(cur)
			cur = ""
		else:
			if cur == "" and gap:
				cur = SP
			gap = false
			cur += ch
		i += 1
	if cur != "":
		out.append(cur)
	return out


const SP := "\u0001"


static func _is_cjk(s: String) -> bool:
	return s.length() > 0 and s.unicode_at(0) >= 0x2e80


static func _hash(a: int, b: int) -> float:
	var h := (a * 374761393 + b * 668265263) & 0x7fffffff
	h = ((h ^ (h >> 13)) * 1274126177) & 0x7fffffff
	return float(h & 0xffff) / 65535.0
