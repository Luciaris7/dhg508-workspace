# Normalize text to LF so Windows and Linux checkouts stay identical.
* text=auto eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.ogg binary
*.bin binary
*.otf binary
*.ttf binary
*.tpz binary
*.exe binary
*.apk binary
*.zip binary

# Generated art sources are large; keep them out of diffs.
tools/src/cg/*_raw.png binary
