{
  "name": "observation-log",
  "version": "1.0.1",
  "private": true,
  "description": "OBSERVATION LOG - 2D pixel horror, Godot 4.7, web build on Cloudflare Pages",
  "scripts": {
    "build:web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build_web.ps1",
    "check:static": "node tools/check_static.js",
    "test:unit": "vitest run",
    "test:unit:node": "node --test",
    "test:game": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run.ps1 all",
    "test:e2e": "playwright test",
    "serve": "node tools/serve.js dist 8788",
    "test": "npm run check:static && npm run test:unit",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/deploy.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "vitest": "^5.1.1",
    "wrangler": "^4.0.0"
  }
}
